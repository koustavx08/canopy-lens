# Base URL of the CanopyLens API.
# Leave empty in development: Vite proxies /api to VITE_PROXY_TARGET.
# In production set it to the deployed backend, e.g. https://canopylens-api.onrender.com
VITE_API_BASE_URL=

# API key sent as `X-API-Key` on every request, when the backend requires one
# (CANOPYLENS_API_KEYS). Compiled into the bundle, so anyone who opens the page
# can read it: it keeps a public address from being usable by anything that has
# not been handed the build, and it is not a substitute for a real session.
VITE_API_KEY=

# Where the Vite dev server proxies /api requests (development only).
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Optional: a MapLibre style URL (vector or raster) to replace the built-in
# key-free basemaps. Leave empty to use Esri World Imagery / OpenStreetMap.
VITE_BASEMAP_STYLE_URL=
