# Normalize line endings so shell scripts stay LF (they break on Linux and in
# Docker with CRLF) while PowerShell scripts stay CRLF on checkout.
* text=auto eol=lf

*.sh      text eol=lf
Dockerfile text eol=lf
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binary assets: never touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.tif  binary
*.tiff binary
*.kmz  binary
*.pth  binary
*.pt   binary
