# CanopyLens environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` at the repository root and edit as needed.
# Every backend variable is read by `backend/app/config.py` through
# pydantic-settings with the prefix CANOPYLENS_. Anything left unset falls back
# to the default shown here, so `.env` is optional for local development.
#
# Frontend variables live in `frontend/.env` (see `frontend/.env.example`);
# Vite only exposes variables prefixed with VITE_ to browser code.
# ---------------------------------------------------------------------------

# --- Service identity -------------------------------------------------------
# Display name reported by GET /api/health and the root endpoint.
CANOPYLENS_APP_NAME=CanopyLens API
# "development" or "production". Reported to the client; does not gate features.
CANOPYLENS_ENVIRONMENT=development
# Python logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
CANOPYLENS_LOG_LEVEL=INFO

# --- HTTP -------------------------------------------------------------------
# Interface uvicorn binds to. Use 0.0.0.0 inside Docker, 127.0.0.1 to stay local.
CANOPYLENS_HOST=0.0.0.0
# Port uvicorn binds to.
CANOPYLENS_PORT=8000
# Comma-separated list of browser origins allowed to call the API directly.
# In development the Vite dev server proxies /api, so CORS is not exercised.
# In production set this to the deployed frontend origin, e.g.
# https://canopylens.vercel.app
CANOPYLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ----------------------------------------------------------------
# Where uploaded imagery and analysis results are written. Relative paths are
# resolved against the repository root. Must be writable by the API process.
CANOPYLENS_DATA_DIR=backend/.data
# Hard limit for a single uploaded file, in megabytes. Requests above this are
# rejected with HTTP 413 and error code `payload_too_large`.
CANOPYLENS_MAX_UPLOAD_MB=512

# Separate, much lower limit for boundary files. A KML or GeoJSON is text
# describing an outline; a few megabytes is already an extremely detailed
# one, and the imagery allowance has no business applying to it.
CANOPYLENS_MAX_BOUNDARY_UPLOAD_MB=32

# --- Processing limits ------------------------------------------------------
# Edge length (pixels) of each tile fed to a detection engine.
CANOPYLENS_TILE_SIZE=800
# Overlap (pixels) between neighbouring tiles. Must be smaller than TILE_SIZE.
# Overlap exists so crowns straddling a tile edge are seen whole by at least one
# tile; duplicates are removed afterwards by spatial non-maximum suppression.
CANOPYLENS_TILE_OVERLAP=160
# Rasters with fewer pixels than this are processed in one pass instead of
# being tiled. Raise it on machines with plenty of RAM, lower it on small ones.
CANOPYLENS_MAX_PIXELS_WITHOUT_TILING=4000000

# --- Detection defaults -----------------------------------------------------
# Initial confidence threshold offered to the UI (0.0-1.0). The user can change
# it per analysis; this only seeds the control.
CANOPYLENS_DEFAULT_CONFIDENCE=0.30
# Initial minimum crown area filter, in square metres. Only applied when the
# imagery carries enough geospatial metadata to convert pixels to metres.
CANOPYLENS_DEFAULT_MIN_CROWN_AREA_M2=1.0
# Detection engine to use: "auto" picks the best engine that actually reports
# itself available at runtime. Set a specific engine id to pin it.
CANOPYLENS_DEFAULT_ENGINE=auto
